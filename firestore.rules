rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Validation Blueprints
    function isValidSettings(s) {
      return s is map
        && s.keys().hasAll([
          'weekdayCap', 'weekendCap', 'weekendPcIpadCap', 'requirePinForTasks',
          'adultPin', 'ntfyTopic', 'ntfyEnabled', 'ntfyOnStart',
          'ntfyOnPause', 'ntfyFiveMin', 'ntfyOnEnd'
        ])
        && s.keys().hasOnly([
          'weekdayCap', 'weekdayMobileCap', 'weekendCap', 'weekendPcIpadCap',
          'requirePinForTasks', 'adultPin', 'ntfyTopic', 'ntfyEnabled',
          'ntfyOnStart', 'ntfyOnPause', 'ntfyFiveMin', 'ntfyOnEnd'
        ])
        && s.weekdayCap is int && s.weekdayCap >= 15 && s.weekdayCap <= 300
        && (!('weekdayMobileCap' in s) || (s.weekdayMobileCap is int && s.weekdayMobileCap >= 0 && s.weekdayMobileCap <= 300))
        && s.weekendCap is int && s.weekendCap >= 30 && s.weekendCap <= 360
        && s.weekendPcIpadCap is int && s.weekendPcIpadCap >= 30 && s.weekendPcIpadCap <= 240
        && s.requirePinForTasks is bool
        && s.adultPin is string && s.adultPin.size() == 4 && s.adultPin.matches('^[0-9]{4}$')
        && s.ntfyTopic is string && s.ntfyTopic.size() <= 64
        && (s.ntfyTopic == '' || s.ntfyTopic.matches('^[a-zA-Z0-9_\\-]{6,64}$'))
        && s.ntfyEnabled is bool
        && s.ntfyOnStart is bool
        && s.ntfyOnPause is bool
        && s.ntfyFiveMin is bool
        && s.ntfyOnEnd is bool;
    }

    function isValidWallet(w) {
      return w is map
        && w.keys().hasAll(['earnedSeconds', 'consumedSeconds'])
        && w.keys().hasOnly(['earnedSeconds', 'consumedSeconds'])
        && w.earnedSeconds is int && w.earnedSeconds >= 0 && w.earnedSeconds <= 36000
        && w.consumedSeconds is int && w.consumedSeconds >= 0 && w.consumedSeconds <= w.earnedSeconds;
    }

    function isValidWallets(ws) {
      return ws is map
        && ws.keys().hasAll(['pc_ipad', 'mobile'])
        && ws.keys().hasOnly(['pc_ipad', 'mobile'])
        && isValidWallet(ws.pc_ipad)
        && isValidWallet(ws.mobile);
    }

    function isValidRunningTimer(rt) {
      return rt is map
        && rt.keys().hasAll(['active', 'wallet', 'startedAt', 'baseConsumed'])
        && rt.keys().hasOnly(['active', 'wallet', 'startedAt', 'baseConsumed'])
        && rt.active is bool
        && rt.wallet is string && rt.wallet.size() <= 16 && rt.wallet in ['', 'pc_ipad', 'mobile']
        && rt.startedAt is int && rt.startedAt >= 0
        && rt.baseConsumed is int && rt.baseConsumed >= 0 && rt.baseConsumed <= 36000;
    }

    function isValidActiveBreak(ab) {
      return ab is map
        && ab.keys().hasAll(['active', 'endTimestamp'])
        && ab.keys().hasOnly(['active', 'endTimestamp'])
        && ab.active is bool
        && ab.endTimestamp is int && ab.endTimestamp >= 0;
    }

    function isValidTaskList(tasks) {
      return tasks is list
        && tasks.size() <= 40
        && (
          tasks.size() == 0
          || (
            tasks[0] is map
            && tasks[0].keys().hasAll([
              'id', 'title', 'note', 'isBonus', 'fixedMinutes',
              'minutes', 'wallet', 'schedule', 'completed'
            ])
            && tasks[0].keys().hasOnly([
              'id', 'title', 'note', 'isBonus', 'fixedMinutes',
              'minutes', 'wallet', 'schedule', 'completed'
            ])
            && tasks[0].id is string && tasks[0].id.size() <= 64
            && tasks[0].title is string && tasks[0].title.size() <= 200
            && tasks[0].note is string && tasks[0].note.size() <= 300
            && tasks[0].isBonus is bool
            && tasks[0].fixedMinutes is int && tasks[0].fixedMinutes >= 0 && tasks[0].fixedMinutes <= 120
            && tasks[0].minutes is int && tasks[0].minutes >= 0 && tasks[0].minutes <= 360
            && tasks[0].wallet is string && tasks[0].wallet in ['auto', 'pc_ipad', 'mobile']
            && tasks[0].schedule is string && tasks[0].schedule in ['all', 'weekday', 'weekend']
            && tasks[0].completed is bool
          )
        );
    }

    function isValidUndoStack(stack) {
      return stack is list
        && stack.size() <= 50
        && (
          stack.size() == 0
          || (
            stack[0] is map
            && stack[0].keys().hasAll([
              'id', 'type', 'taskId', 'label', 'pcDeltaSec', 'mobDeltaSec', 'createdAt'
            ])
            && stack[0].keys().hasOnly([
              'id', 'type', 'taskId', 'label', 'pcDeltaSec', 'mobDeltaSec', 'createdAt'
            ])
            && stack[0].id is string && stack[0].id.size() <= 64
            && stack[0].type is string && stack[0].type in ['task', 'manual']
            && stack[0].taskId is string && stack[0].taskId.size() <= 64
            && stack[0].label is string && stack[0].label.size() <= 240
            && stack[0].pcDeltaSec is int && stack[0].pcDeltaSec >= 0 && stack[0].pcDeltaSec <= 36000
            && stack[0].mobDeltaSec is int && stack[0].mobDeltaSec >= 0 && stack[0].mobDeltaSec <= 36000
            && stack[0].createdAt is int && stack[0].createdAt >= 0
          )
        );
    }

    function isValidPlan(data) {
      return data is map
        && data.keys().hasAll([
          'ownerId', 'schemaVersion', 'currentDate', 'nightReadingDone',
          'weekendAutoCreditedDate', 'settings', 'wallets', 'tasks',
          'minuteUndoStack', 'runningTimer', 'activeBreak', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'schemaVersion', 'currentDate', 'nightReadingDone',
          'weekendAutoCreditedDate', 'settings', 'wallets', 'tasks',
          'minuteUndoStack', 'runningTimer', 'activeBreak', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.schemaVersion is int && data.schemaVersion >= 1 && data.schemaVersion <= 20
        && isValidDateKey(data.currentDate)
        && data.nightReadingDone is bool
        && data.weekendAutoCreditedDate is string && data.weekendAutoCreditedDate.size() <= 10
        && (data.weekendAutoCreditedDate == '' || isValidDateKey(data.weekendAutoCreditedDate))
        && isValidSettings(data.settings)
        && isValidWallets(data.wallets)
        && isValidTaskList(data.tasks)
        && isValidUndoStack(data.minuteUndoStack)
        && isValidRunningTimer(data.runningTimer)
        && isValidActiveBreak(data.activeBreak)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHistoryRecord(data, dateKey) {
      return data is map
        && data.keys().hasAll([
          'ownerId', 'date', 'earnedMin', 'consumedMin', 'pcEarnedMin',
          'pcConsumedMin', 'mobEarnedMin', 'mobConsumedMin', 'tasksCompleted',
          'totalTasks', 'nightReadingDone', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'date', 'earnedMin', 'consumedMin', 'pcEarnedMin',
          'pcConsumedMin', 'mobEarnedMin', 'mobConsumedMin', 'tasksCompleted',
          'totalTasks', 'nightReadingDone', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidDateKey(data.date)
        && data.date == dateKey
        && data.earnedMin is int && data.earnedMin >= 0 && data.earnedMin <= 600
        && data.consumedMin is int && data.consumedMin >= 0 && data.consumedMin <= 600
        && data.pcEarnedMin is int && data.pcEarnedMin >= 0 && data.pcEarnedMin <= 600
        && data.pcConsumedMin is int && data.pcConsumedMin >= 0 && data.pcConsumedMin <= 600
        && data.mobEarnedMin is int && data.mobEarnedMin >= 0 && data.mobEarnedMin <= 600
        && data.mobConsumedMin is int && data.mobConsumedMin >= 0 && data.mobConsumedMin <= 600
        && data.tasksCompleted is int && data.tasksCompleted >= 0 && data.tasksCompleted <= 40
        && data.totalTasks is int && data.totalTasks >= 0 && data.totalTasks <= 40
        && data.nightReadingDone is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /plans/{userId}
    match /plans/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidPlan(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidPlan(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Timer / Active Break update
          incoming().diff(existing()).affectedKeys().hasOnly([
            'wallets', 'runningTimer', 'activeBreak', 'updatedAt'
          ]) ||
          // Action: Task completion / Undo / Extra minutes
          incoming().diff(existing()).affectedKeys().hasOnly([
            'wallets', 'tasks', 'minuteUndoStack', 'runningTimer', 'updatedAt'
          ]) ||
          // Action: Night reading toggle
          incoming().diff(existing()).affectedKeys().hasOnly([
            'nightReadingDone', 'updatedAt'
          ]) ||
          // Action: Settings & task management
          incoming().diff(existing()).affectedKeys().hasOnly([
            'settings', 'tasks', 'wallets', 'minuteUndoStack', 'weekendAutoCreditedDate', 'updatedAt'
          ]) ||
          // Action: Day rollover / reset / backup import
          incoming().diff(existing()).affectedKeys().hasOnly([
            'schemaVersion', 'currentDate', 'nightReadingDone', 'weekendAutoCreditedDate',
            'settings', 'wallets', 'tasks', 'minuteUndoStack', 'runningTimer', 'activeBreak', 'updatedAt'
          ])
        );

      allow delete: if false;

      // Subcollection: /plans/{userId}/history/{dateKey}
      match /history/{dateKey} {
        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidDateKey(dateKey)
          && get(/databases/$(database)/documents/plans/$(userId)).data.ownerId == request.auth.uid;

        allow list: if isOwner(userId)
          && resource.data.ownerId == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidDateKey(dateKey)
          && isValidHistoryRecord(incoming(), dateKey)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/plans/$(userId)).data.ownerId == request.auth.uid;

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidDateKey(dateKey)
          && isValidHistoryRecord(incoming(), dateKey)
          && incoming().ownerId == existing().ownerId
          && incoming().date == existing().date
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'earnedMin', 'consumedMin', 'pcEarnedMin', 'pcConsumedMin',
            'mobEarnedMin', 'mobConsumedMin', 'tasksCompleted', 'totalTasks',
            'nightReadingDone', 'updatedAt'
          ])
          && get(/databases/$(database)/documents/plans/$(userId)).data.ownerId == request.auth.uid;

        allow delete: if false;
      }
    }
  }
}
